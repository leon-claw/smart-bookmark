{
  "name": "@smart-bookmark/desktop",
  "productName": "Smart Bookmark",
  "version": "0.1.0",
  "description": "Local Chrome bookmark manager",
  "private": true,
  "type": "module",
  "main": "main/main.mjs",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "package:win": "vite build && electron-builder --win portable --x64",
    "check": "tsc --noEmit && node --check main/main.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "lucide-react": "0.546.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "40.10.2",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "local.smartbookmark.desktop",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "main/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false
    }
  }
}
